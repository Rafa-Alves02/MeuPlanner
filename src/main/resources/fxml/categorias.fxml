<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.MeuPlanner.app.CategoriasController"
            styleClass="root-pane">

    <left>
        <VBox styleClass="sidebar" spacing="4" prefWidth="180">
            <Label text="MeuPlanner" styleClass="logo"/>
            <Button text="Dashboard"      onAction="#irDashboard"      maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Contas"         onAction="#irContas"         maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Lançamentos"    onAction="#irLancamentos"    maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Transferências" onAction="#irTransferencias" maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Categorias"     onAction="#irCategorias"     maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Metas"          onAction="#irMetas"          maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Relatórios"     onAction="#irRelatorios"     maxWidth="Infinity" styleClass="nav-btn"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="content" spacing="20">
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

            <Label text="Categorias" styleClass="page-title"/>

            <HBox spacing="10">
                <TextField fx:id="txtNome"  promptText="Nome da categoria" prefWidth="200"/>
                <ComboBox  fx:id="cmbTipo"  promptText="Tipo"              prefWidth="140"/>
                <TextField fx:id="txtCor"   promptText="Cor (#HEX)"        prefWidth="120"/>
                <Button text="Adicionar" onAction="#adicionarCategoria" styleClass="btn-primary"/>
            </HBox>

            <TableView fx:id="tabelaCategorias" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNome"  text="Nome"  prefWidth="260"/>
                    <TableColumn fx:id="colTipo"  text="Tipo"  prefWidth="160"/>
                    <TableColumn fx:id="colCor"   text="Cor"   prefWidth="120"/>
                    <TableColumn fx:id="colAcoes" text="Ações" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
