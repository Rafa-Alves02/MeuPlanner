<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.MeuPlanner.app.MetasController"
            styleClass="root-pane">

    <left>
        <VBox styleClass="sidebar" spacing="4" prefWidth="180">
            <Label text="MeuPlanner" styleClass="logo"/>
            <Button text="Dashboard"      onAction="#irDashboard"      maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Contas"         onAction="#irContas"         maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Lançamentos"    onAction="#irLancamentos"    maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Transferências" onAction="#irTransferencias" maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Categorias"     onAction="#irCategorias"     maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Metas"          onAction="#irMetas"          maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Relatórios"     onAction="#irRelatorios"     maxWidth="Infinity" styleClass="nav-btn"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="content" spacing="20">
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

            <Label text="Metas de Economia" styleClass="page-title"/>

            <HBox spacing="10">
                <TextField fx:id="txtDescricao"  promptText="Descrição"    prefWidth="200"/>
                <TextField fx:id="txtValorAlvo"  promptText="Valor alvo"   prefWidth="120"/>
                <DatePicker fx:id="dataLimite"   promptText="Data limite"  prefWidth="150"/>
                <ComboBox  fx:id="cmbConta"      promptText="Conta"        prefWidth="150"/>
                <Button text="Criar Meta" onAction="#criarMeta" styleClass="btn-primary"/>
            </HBox>

            <TableView fx:id="tabelaMetas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDescricao"  text="Descrição"  prefWidth="200"/>
                    <TableColumn fx:id="colAlvo"       text="Alvo"       prefWidth="120"/>
                    <TableColumn fx:id="colAtual"      text="Atual"      prefWidth="120"/>
                    <TableColumn fx:id="colProgresso"  text="Progresso"  prefWidth="160"/>
                    <TableColumn fx:id="colLimite"     text="Prazo"      prefWidth="110"/>
                    <TableColumn fx:id="colAcoes"      text="Ações"      prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
