<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.MeuPlanner.app.DashboardController"
            styleClass="root-pane">

    <left>
        <VBox styleClass="sidebar" spacing="4" prefWidth="180">
            <Label text="MeuPlanner" styleClass="logo"/>
            <Button text="Dashboard"      onAction="#irDashboard"      maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Contas"         onAction="#irContas"         maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Lançamentos"    onAction="#irLancamentos"    maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Transferências" onAction="#irTransferencias" maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Categorias"     onAction="#irCategorias"     maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Metas"          onAction="#irMetas"          maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Relatórios"     onAction="#irRelatorios"     maxWidth="Infinity" styleClass="nav-btn"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="content" spacing="20">
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

            <Label text="Dashboard" styleClass="page-title"/>

            <HBox spacing="20">
                <VBox styleClass="card" prefWidth="210">
                    <Label text="Saldo Total" styleClass="card-label"/>
                    <Label fx:id="lblSaldoTotal" text="R$ 0,00" styleClass="value-positive"/>
                </VBox>
                <VBox styleClass="card" prefWidth="210">
                    <Label text="Entradas do Mês" styleClass="card-label"/>
                    <Label fx:id="lblEntradas" text="R$ 0,00" styleClass="value-positive"/>
                </VBox>
                <VBox styleClass="card" prefWidth="210">
                    <Label text="Gastos do Mês" styleClass="card-label"/>
                    <Label fx:id="lblGastos" text="R$ 0,00" styleClass="value-negative"/>
                </VBox>
            </HBox>

            <Label text="Alertas Ativos" styleClass="section-title"/>
            <ListView fx:id="listaAlertas" prefHeight="130"/>

            <Label text="Metas em Andamento" styleClass="section-title"/>
            <ListView fx:id="listaMetas" prefHeight="130"/>
        </VBox>
    </center>

</BorderPane>
