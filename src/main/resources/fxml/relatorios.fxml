<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.MeuPlanner.app.RelatoriosController"
            styleClass="root-pane">

    <left>
        <VBox styleClass="sidebar" spacing="4" prefWidth="180">
            <Label text="MeuPlanner" styleClass="logo"/>
            <Button text="Dashboard"      onAction="#irDashboard"      maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Contas"         onAction="#irContas"         maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Lançamentos"    onAction="#irLancamentos"    maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Transferências" onAction="#irTransferencias" maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Categorias"     onAction="#irCategorias"     maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Metas"          onAction="#irMetas"          maxWidth="Infinity" styleClass="nav-btn"/>
            <Button text="Relatórios"     onAction="#irRelatorios"     maxWidth="Infinity" styleClass="nav-btn"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="content" spacing="20">
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

            <Label text="Relatórios" styleClass="page-title"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Mês:" styleClass="form-label"/>
                <ComboBox fx:id="cmbMes" prefWidth="130"/>
                <Button text="Carregar" onAction="#carregar" styleClass="btn-primary"/>
            </HBox>

            <HBox spacing="30" VBox.vgrow="ALWAYS">
                <PieChart fx:id="graficoPizza" title="Gastos por Categoria"
                          prefWidth="400" prefHeight="350"/>
                <LineChart fx:id="graficoLinha" prefWidth="420" prefHeight="350">
                    <xAxis><CategoryAxis label="Mês"/></xAxis>
                    <yAxis><NumberAxis label="R$"/></yAxis>
                </LineChart>
            </HBox>
        </VBox>
    </center>

</BorderPane>
