<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.MeuPlanner.app.ContasController"
            styleClass="root-pane">

    <left>
        <fx:include source="sidebar.fxml"/>
    </left>

    <center>
        <VBox styleClass="content" spacing="20">
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

            <Label text="// Contas" styleClass="page-title"/>

            <HBox spacing="10">
                <TextField fx:id="txtNome" promptText="Nome da conta" prefWidth="200"/>
                <ComboBox fx:id="cmbTipo" promptText="Tipo" prefWidth="160"/>
                <TextField fx:id="txtSaldo" promptText="Saldo inicial" prefWidth="140"/>
                <Button text="Adicionar" onAction="#adicionarConta" styleClass="btn-primary"/>
            </HBox>

            <TableView fx:id="tabelaContas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNome"   text="Nome"         prefWidth="220"/>
                    <TableColumn fx:id="colTipo"   text="Tipo"         prefWidth="160"/>
                    <TableColumn fx:id="colSaldo"  text="Saldo Atual"  prefWidth="160"/>
                    <TableColumn fx:id="colAcoes"  text="Ações"        prefWidth="100"/>
                </columns>
            </TableView>

            <Label fx:id="lblSaldoGeral" text="Saldo Geral: R$ 0,00" styleClass="section-title"/>
        </VBox>
    </center>

</BorderPane>
